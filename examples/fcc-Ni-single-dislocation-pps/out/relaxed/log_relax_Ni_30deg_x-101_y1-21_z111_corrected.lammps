# Relax one dislocation in a p p s slab (x glide direction, y line, z glide-plane normal).
# Required -var:  name      cell basename (…_cut.lmp in celldir)
#                 celldir   directory with the cut cell and box-correction_<name>.lmp
#                 outdir    output directory
#                 pot       eam/alloy file;  elem  element name in it
#                 corr      0 = box as built (uncorrected),  1 = corrected period vector (Lx', delta)
# corr 1 reads <name>_corrected-period-vector.lmp from apply_period_vector.py: a TRICLINIC cell in the
# frame X = line, Y = -glide, Z = normal (LAMMPS can only tilt its second box vector, see that script).
units           metal
atom_style      atomic
boundary        p p s
if "${corr} == 1" then   "read_data ${celldir}/${name}_corrected-period-vector.lmp"   "variable variant string corrected" else   "read_data ${celldir}/${name}_cut.lmp"   "variable variant string uncorrected"
read_data ${celldir}/${name}_corrected-period-vector.lmp
read_data out/cells/${name}_corrected-period-vector.lmp
read_data out/cells/Ni_30deg_x-101_y1-21_z111_corrected-period-vector.lmp
Reading data file ...
  triclinic box = (0 0 0) to (25.866611 148.7187 146.32365) with tilt (1.0777755 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  51624 atoms
  read_data CPU = 0.121 seconds
variable variant string corrected
include         ${celldir}/box-correction_${name}.lmp
include         out/cells/box-correction_${name}.lmp
include         out/cells/box-correction_Ni_30deg_x-101_y1-21_z111.lmp
# written by build_single_dislocation_cell.py for Ni_30deg_x-101_y1-21_z111
variable Lx_built  equal 149.3409511866
variable Lx_corr   equal 148.7186972233   # = (L_top + L_bot)/2
variable xy_corr   equal -1.0777754868   # = <dU_y> over the halves
variable z_glide   equal 72.1457000000
variable x_line    equal 74.6704755933
variable z_fix_lo  equal 5.796819   # 3 (111) layers per face held in z
variable z_fix_hi  equal 138.494560
variable b_edge    equal 1.2445079349
variable b_screw   equal 2.1555509736

pair_style      eam/alloy
pair_coeff      * * ${pot} ${elem}
pair_coeff      * * Cu_Ni_Fischer_2018.eam.alloy ${elem}
pair_coeff      * * Cu_Ni_Fischer_2018.eam.alloy Ni

# 2D-dynamic boundary (Rodney): the 3 outermost (111) layers per z-face move only in x and y
region          r_lo block INF INF INF INF INF ${z_fix_lo} units box
region          r_lo block INF INF INF INF INF 5.796819 units box
region          r_hi block INF INF INF INF ${z_fix_hi} INF units box
region          r_hi block INF INF INF INF 138.49456 INF units box
group           g_lo region r_lo
2160 atoms in group g_lo
group           g_hi region r_hi
2142 atoms in group g_hi
group           g_surf union g_lo g_hi
4302 atoms in group g_surf
fix             f_2d g_surf setforce NULL NULL 0.0

compute         pe all pe/atom
compute         s all stress/atom NULL
compute         cna all cna/atom 3.006
thermo          200
thermo_style    custom step pe fnorm pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.8g

min_style       fire
minimize        0.0 1.0e-4 50000 100000
