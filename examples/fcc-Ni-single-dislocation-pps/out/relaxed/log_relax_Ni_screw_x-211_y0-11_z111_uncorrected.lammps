# Relax one dislocation in a p p s slab (x glide direction, y line, z glide-plane normal).
# Required -var:  name      cell basename (…_cut.lmp in celldir)
#                 celldir   directory with the cut cell and box-correction_<name>.lmp
#                 outdir    output directory
#                 pot       eam/alloy file;  elem  element name in it
#                 corr      0 = box as built (uncorrected),  1 = corrected period vector (Lx', xy')
units           metal
atom_style      atomic
boundary        p p s
read_data       ${celldir}/${name}_cut.lmp
read_data       out/cells/${name}_cut.lmp
read_data       out/cells/Ni_screw_x-211_y0-11_z111_cut.lmp
Reading data file ...
  orthogonal box = (0 0 0) to (146.57747 29.868189 146.32365)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  58752 atoms
  read_data CPU = 0.158 seconds
include         ${celldir}/box-correction_${name}.lmp
include         out/cells/box-correction_${name}.lmp
include         out/cells/box-correction_Ni_screw_x-211_y0-11_z111.lmp
# written by build_single_dislocation_cell.py for Ni_screw_x-211_y0-11_z111
variable Lx_built  equal 146.5774652081
variable Lx_corr   equal 146.5774652081   # = (L_top + L_bot)/2
variable xy_corr   equal 1.2445079349   # = <dU_y> over the halves
variable z_glide   equal 72.1457000000
variable x_line    equal 73.2887326041
variable z_fix_lo  equal 5.796819   # 3 (111) layers per face held in z
variable z_fix_hi  equal 138.494560
variable b_edge    equal 0.0000000000
variable b_screw   equal 2.4890158698

pair_style      eam/alloy
pair_coeff      * * ${pot} ${elem}
pair_coeff      * * Cu_Ni_Fischer_2018.eam.alloy ${elem}
pair_coeff      * * Cu_Ni_Fischer_2018.eam.alloy Ni

if "${corr} == 1" then   "change_box all triclinic"   "change_box all x final $(xlo) $(xlo+v_Lx_corr) xy final ${xy_corr} remap units box"   "variable variant string corrected" else   "variable variant string uncorrected"
variable variant string uncorrected

# 2D-dynamic boundary (Rodney): the 3 outermost (111) layers per z-face move only in x and y
region          r_lo block INF INF INF INF INF ${z_fix_lo} units box
region          r_lo block INF INF INF INF INF 5.796819 units box
region          r_hi block INF INF INF INF ${z_fix_hi} INF units box
region          r_hi block INF INF INF INF 138.49456 INF units box
group           g_lo region r_lo
2448 atoms in group g_lo
group           g_hi region r_hi
2448 atoms in group g_hi
group           g_surf union g_lo g_hi
4896 atoms in group g_surf
fix             f_2d g_surf setforce NULL NULL 0.0

compute         pe all pe/atom
compute         s all stress/atom NULL
compute         cna all cna/atom 3.006
thermo          200
thermo_style    custom step pe fnorm pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.8g

min_style       fire
minimize        0.0 1.0e-4 50000 100000
